# Removable storage
/devices/platform/soc/soc:*/*.usb/musb-hdrc.*.auto/usb*                      auto    vfat    defaults      voldmanaged=usbdisk:auto
/devices/platform/soc/soc:ap-*/*.sdio/mmc_host/mmc1/mmc1:*/block/mmcblk1     auto    vfat    defaults      voldmanaged=sdcard0:auto,noemulatedsd,encryptable=footer
